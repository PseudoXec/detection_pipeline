# config/secrets.yaml.example
# ----------------------------
# Copy this file to "config/secrets.yaml" ON THE RASPBERRY PI ITSELF and
# fill in real values there. This .example file (with placeholders) is the
# only one of the two that should ever be committed, shared, screenshotted,
# or zipped up for a bug report.
#
# Setup on the Pi:
#   cp config/secrets.yaml.example config/secrets.yaml
#   nano config/secrets.yaml            # fill in real values
#   chmod 600 config/secrets.yaml       # owner-only read/write
#   chown pipeline:pipeline config/secrets.yaml   # or whatever service user you run as
#
# config/secrets.yaml is already in .gitignore - it will never be committed
# by accident. Anything you leave out here just falls back to whatever
# config.yaml / config.py already have (usually null/disabled).
#
# Precedence (highest wins): environment variables > secrets.yaml >
# config.yaml > built-in defaults. See config/config.py's PipelineConfig.load().

camera:
  # full RTSP URL, credentials and all
  rtsp_url: "rtsp://username:password@192.168.1.50:554/stream1"

live:
  # random token required to view the live MJPEG stream / boxes feed.
  # Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
  # Leaving this unset means the live view on port 8090 is open to anyone
  # who can reach the Pi on your LAN.
  auth_token: "REPLACE_ME_WITH_A_GENERATED_TOKEN"

api:
  # the C# command center's detection-intake endpoint
  endpoint_url: "http://192.168.1.10:5086/api/AiDetection/PlateDetected"
